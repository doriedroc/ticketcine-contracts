{
  "name": "@doriedroc/ticketcine-contracts",
  "version": "1.0.0",
  "description": "Contratos gRPC (protobuf) e tipos TS gerados do TicketCine",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "keywords": [],
  "author": {
    "name": "Danilo Cordeiro",
    "email": "dev.danilocordeiro@gmail.com"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doriedroc/ticketcine-contracts.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "generate": "protoc -I ./proto ./proto/*.proto --plugin=./node_modules/.bin/protoc-gen-ts_proto --ts_proto_out=./gen --ts_proto_opt=nestJs=true,package=omit,stringEnums=true"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "failComment": false
        }
      ]
    ]
  },
  "files": [
    "dist",
    "gen",
    "proto"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./proto/*": "./proto/*",
    "./*": "./gen/*.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "semantic-release": "^25.0.9",
    "ts-proto": "^2.18.3",
    "typescript": "^7.0.2"
  }
}
